
সংখ্যা = 10;
ফলাফল = সংখ্যা + 5;
গুণফল = সংখ্যা * 3;
বিয়োগ = গুণফল - ফলাফল;
ভাগফল = গুণফল / 2;


নাম = "বাংলাদেশ";

// দেখাও (print)
দেখাও(সংখ্যা);
দেখাও(ফলাফল);
দেখাও(নাম);

// IF-ELSE শর্ত
যদি (সংখ্যা > 5) {
    দেখাও(ফলাফল);
} নাহলে {
    দেখাও(গুণফল);
}

// WHILE লুপ
গণনা = 1;
যতক্ষণ (গণনা < 4) {
    দেখাও(গণনা);
    গণনা = গণনা + 1;
}
